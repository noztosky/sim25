     if (!accelPosOffset.is_zero()) {
         // calculate the average angular rate across the last IMU update
         // note delAngDT is prevented from being zero in readIMUData()
-        Vector3F angRate = imuDataNew.delAng * (1.0f/imuDataNew.delAngDT);
+        // XLAB PATCH: low-pass (~10 Hz) the lever-arm angular rate. The raw
+        // delta-angle rate is unfiltered (no INS_GYRO_FILTER, no notch), so with
+        // a large IMU offset gyro vibration injects noise into the velocity
+        // outputs consumed by the position controller (flare wobble on vehicles
+        // with the FC far from the CG).
+        Vector3F angRateRaw = imuDataNew.delAng * (1.0f/imuDataNew.delAngDT);
+        const ftype alphaLA = constrain_ftype(imuDataNew.delAngDT * M_2PI * 10.0f, 0.0f, 1.0f);
+        angRateFiltLA += (angRateRaw - angRateFiltLA) * alphaLA;
+        const Vector3F &angRate = angRateFiltLA;
 
         // Calculate the velocity of the body frame origin relative to the IMU in body frame
         // and rotate into earth frame. Note % operator has been overloaded to perform a cross product
